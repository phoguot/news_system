<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
$id = isset($this->id) ? (int) $this->id : null;
$values = (array) ($this->values ?? []);
$errors = (array) ($this->errors ?? []);
$title = (string) ($this->title ?? 'Menu');
$csrf = (string) ($this->csrfHash ?? '');
$e = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/menus', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));
$listUrl = $this->url('admin/menus');
$pageTitle = $id === null ? 'Thêm menu' : $title;

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$panelIcon = static function (string $inner): string {
    return '<span class="form-panel-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"'
        . ' stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
        . $inner . '</svg></span>';
};

$targetValue = $val('target', \Frontend\Model\Menu\MenuConst::TARGET_SELF);
$targetOptions = '';
foreach (\Frontend\Model\Menu\MenuConst::TARGET_LABELS as $target => $label) {
    $targetOptions .= '<option value="' . $e($target) . '"' . ($target === $targetValue ? ' selected' : '') . '>'
        . $e($label) . '</option>';
}
$active = $val('isActive', '1');

$html = '<div class="entry-page"><div class="entry-page-head"><div>'
    . '<div class="breadcrumb"><a href="' . $e($listUrl) . '">Menu</a><span>&rsaquo;</span><span>'
    . $e($pageTitle) . '</span></div>'
    . '<h1>' . $e($pageTitle) . '</h1>'
    . '<p class="subtitle">Tạo liên kết điều hướng hiển thị ngoài website.</p></div>'
    . '<a class="btn btn-ghost entry-back" href="' . $e($listUrl) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>'
    . 'Quay lại danh sách</a></div>';

$html .= '<form class="entry-form" method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="entry-form-grid"><div class="entry-main">';
$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/>')
    . '<div><h2>Thông tin menu</h2><p>Nhập nhãn và đường dẫn người dùng sẽ bấm.</p></div></div>';
$html .= '<div class="form-row cols-2">';
$html .= $field(
    'label',
    'Tên menu *',
    '<input class="form-input" id="f-label" name="label" maxlength="120" required'
    . ' placeholder="Nhập tên menu" value="' . $e($val('label')) . '">'
);
$html .= $field(
    'url',
    'URL *',
    '<input class="form-input" id="f-url" name="url" maxlength="255" required value="' . $e($val('url')) . '"'
    . ' placeholder="/tin-tuc">',
    'Dùng đường dẫn nội bộ bắt đầu bằng / hoặc URL đầy đủ.'
);
$html .= '</div>';
$html .= $field(
    'target',
    'Cách mở',
    '<select class="form-select" id="f-target" name="target">' . $targetOptions . '</select>'
);
$html .= '</section></div><div class="entry-side">';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>')
    . '<div><h2>Tùy chọn hiển thị</h2><p>Thiết lập thứ tự và trạng thái menu.</p></div></div>';
$html .= $field(
    'sortOrder',
    'Thứ tự',
    '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="'
    . $e($val('sortOrder', '0')) . '">',
    'Số nhỏ hiển thị trước.'
);
$html .= $field(
    'isActive',
    'Hiển thị',
    '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($active === '1' ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($active === '1' ? '' : ' selected') . '>Tắt</option></select>'
);
$html .= '<div class="notice-box"><strong>Lưu ý</strong>'
    . '<p>Menu tắt sẽ không xuất hiện trên website nhưng vẫn giữ nguyên dữ liệu để bật lại sau.</p></div>';
$html .= '</section></div></div>';

$html .= '<div class="entry-form-actions">'
    . '<a class="btn btn-ghost" href="' . $e($listUrl) . '">Hủy</a>'
    . '<button class="btn btn-primary" type="submit">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>'
    . '<polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>'
    . 'Lưu menu</button></div>';

$html .= '</form></div>';

echo $html;
