<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
$id = isset($this->id) ? (int) $this->id : null;
$values = (array) ($this->values ?? []);
$errors = (array) ($this->errors ?? []);
$title = (string) ($this->title ?? 'Menu');
$csrf = (string) ($this->csrfHash ?? '');
$e = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/menus', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$targetValue = $val('target', \Frontend\Model\Menu\MenuConst::TARGET_SELF);
$targetOptions = '';
foreach (\Frontend\Model\Menu\MenuConst::TARGET_LABELS as $target => $label) {
    $targetOptions .= '<option value="' . $e($target) . '"' . ($target === $targetValue ? ' selected' : '') . '>'
        . $e($label) . '</option>';
}
$active = $val('isActive', '1');

$html = '<div class="page-header"><div><h1>' . $e($title) . '</h1>'
    . '<p class="subtitle">Quay lại <a href="' . $e($this->url('admin/menus')) . '">danh sách menu</a>.</p></div></div>';

$html .= '<div class="card"><form method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="form-row cols-2">';
$html .= $field('label', 'Tên menu *', '<input class="form-input" id="f-label" name="label" maxlength="120" required value="' . $e($val('label')) . '">');
$html .= $field('url', 'URL *', '<input class="form-input" id="f-url" name="url" maxlength="255" required value="' . $e($val('url')) . '" placeholder="/tin-tuc">', 'Dùng đường dẫn nội bộ bắt đầu bằng / hoặc URL đầy đủ.');
$html .= $field('target', 'Cách mở', '<select class="form-select" id="f-target" name="target">' . $targetOptions . '</select>');
$html .= $field('sortOrder', 'Thứ tự', '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="' . $e($val('sortOrder', '0')) . '">');
$html .= $field('isActive', 'Hiển thị', '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($active === '1' ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($active === '1' ? '' : ' selected') . '>Tắt</option></select>');
$html .= '</div>';

$html .= '<div class="form-actions">'
    . '<button class="btn btn-primary" type="submit">Lưu</button>'
    . '<a class="btn btn-ghost" href="' . $e($this->url('admin/menus')) . '">Hủy</a></div>';

$html .= '</form></div>';

echo $html;
