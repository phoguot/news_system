<?php /** @var \Laminas\View\Renderer\PhpRenderer $this */

/** @var string|null $error */
$error    = isset($this->error) && is_string($this->error) ? $this->error : null;
$csrfHash = (string) ($this->csrfHash ?? '');
$identity = (string) ($this->identity ?? '');

// Chuỗi dựng sẵn bằng ternary — phtml giữ sạch control structure (phpcs)
$alertHtml = $error === null
    ? ''
    : '<div class="alert visible">'
        . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" '
        . 'style="flex-shrink:0;margin-top:1px">'
        . '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
        . '<span>' . $this->escapeHtml($error) . '</span></div>';

$inputClass = $error === null ? 'form-input' : 'form-input error';
