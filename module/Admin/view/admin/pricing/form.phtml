<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var \Frontend\Model\Service\ServiceModel|null $service */
/** @var \Frontend\Model\Service\ServiceModel|null $parent */
$id = isset($this->id) ? (int) $this->id : null;
$service = $this->service ?? null;
$parent = $this->parent ?? null;
$values = (array) ($this->values ?? []);
$errors = (array) ($this->errors ?? []);
$csrf = (string) ($this->csrfHash ?? '');
$e = fn (mixed $value): string => $this->escapeHtml((string) $value);
$val = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$listUrl = $this->url('admin/pricing');
$actionUrl = $this->url('admin/pricing', ['action' => 'save', 'id' => $id]);
$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $error = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $help = $hint !== '' ? '<div class="field-hint">' . $e($hint) . '</div>' : '';
    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $help . $error . '</div>';
};
$isActive = ! in_array($values['isActive'] ?? 0, [0, '0', false], true);

$html = '<div class="entry-page"><div class="entry-page-head"><div><div class="breadcrumb">'
    . '<a href="' . $e($listUrl) . '">Bảng giá</a><span>&rsaquo;</span><span>Cập nhật giá</span></div>'
    . '<h1>' . $e($service?->name ?? 'Dịch vụ') . '</h1><p class="subtitle">Nhóm: '
    . $e($parent?->name ?? '') . '. Tên và nhóm được đồng bộ từ quản trị Dịch vụ.</p></div>'
    . '<a class="btn btn-ghost entry-back" href="' . $e($listUrl) . '">Quay lại danh sách</a></div>';

$html .= '<form class="entry-form" method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">'
    . '<input type="hidden" name="serviceId" value="' . (int) ($service?->id ?? 0) . '">'
    . '<div class="entry-form-grid"><div class="entry-main"><section class="form-panel">'
    . '<div class="form-panel-head"><div><h2>Thông tin giá</h2>'
    . '<p>Chỉ cấu hình dữ liệu dành riêng cho bảng giá.</p></div></div>'
    . '<div class="form-row cols-2">'
    . $field('price', 'Giá (VNĐ)', '<input class="form-input" id="f-price" name="price" type="number" min="0" value="' . $e($val('price')) . '" placeholder="Để trống = Liên hệ">')
    . $field('unit', 'Đơn vị', '<input class="form-input" id="f-unit" name="unit" maxlength="100" value="' . $e($val('unit')) . '" placeholder="lần / giờ / gói">')
    . '</div>'
    . $field('note', 'Ghi chú', '<input class="form-input" id="f-note" name="note" maxlength="500" value="' . $e($val('note')) . '" placeholder="Đã bao gồm vật tư...">')
    . '</section></div><div class="entry-side"><section class="form-panel">'
    . '<div class="form-panel-head"><div><h2>Hiển thị</h2><p>Thứ tự riêng trong nhóm bảng giá.</p></div></div>'
    . $field('sortOrder', 'Thứ tự', '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="' . $e($val('sortOrder', '0')) . '">', 'Có thể kéo thả trực tiếp ở danh sách.')
    . $field('isActive', 'Hiển thị trong bảng giá', '<select class="form-select" id="f-isActive" name="isActive"><option value="1"' . ($isActive ? ' selected' : '') . '>Có</option><option value="0"' . ($isActive ? '' : ' selected') . '>Tắt</option></select>')
    . '</section></div></div><div class="entry-form-actions">'
    . '<a class="btn btn-ghost" href="' . $e($listUrl) . '">Hủy</a>'
    . '<button class="btn btn-primary" type="submit">Lưu bảng giá</button></div></form></div>';

echo $html;
