<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var int|null $id */
$id     = isset($this->id) ? (int) $this->id : null;
/** @var array<array-key, mixed> $values */
$values = (array) ($this->values ?? []);
$errors = (array) ($this->errors ?? []);
$title  = (string) ($this->title ?? 'Bảng giá');
$csrf   = (string) ($this->csrfHash ?? '');
$e      = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val    = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/pricing', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err  = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$active          = $values['isActive'] ?? 1;
$isActiveChecked = ! ($active === 0 || $active === '0' || $active === false);
$groupValue      = (string) ($values['groupCode'] ?? 'general');
$groupLabels     = \Frontend\Model\Pricing\PricingConst::GROUP_LABELS;
$groupOptions    = '';
foreach ($groupLabels as $code => $label) {
    $sel = $code === $groupValue ? ' selected' : '';
    $groupOptions .= '<option value="' . $e($code) . '"' . $sel . '>' . $e($label) . '</option>';
}

$html = '<div class="page-header"><div><h1>' . $e($title) . '</h1>'
    . '<p class="subtitle">Quay lại <a href="' . $e($this->url('admin/pricing')) . '">danh sách bảng giá</a>.</p></div></div>';

$html .= '<div class="card"><form method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="form-row cols-2">';
$html .= $field('groupCode', 'Nhóm *', '<select class="form-select" id="f-groupCode" name="groupCode">' . $groupOptions . '</select>');
$html .= $field('name', 'Tên mục *', '<input class="form-input" id="f-name" name="name" maxlength="255" required value="' . $e($val('name')) . '">');
$html .= '</div>';

$html .= $field('slug', 'Slug', '<input class="form-input mono" id="f-slug" name="slug" maxlength="255" value="' . $e($val('slug')) . '" placeholder="de-trong-tu-sinh">', 'Để trống = tự sinh từ tên.');

$html .= '<div class="form-row cols-3">';
$html .= $field('price', 'Giá (VNĐ)', '<input class="form-input" id="f-price" name="price" type="number" min="0" value="' . $e($val('price')) . '" placeholder="Để trống = Liên hệ">', 'Để trống hiển thị “Liên hệ”.');
$html .= $field('unit', 'Đơn vị', '<input class="form-input" id="f-unit" name="unit" maxlength="100" value="' . $e($val('unit')) . '" placeholder="lần / giờ / gói">');
$html .= $field('sortOrder', 'Thứ tự', '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="' . $e($val('sortOrder', '0')) . '">');
$html .= '</div>';

$html .= $field('note', 'Ghi chú', '<input class="form-input" id="f-note" name="note" maxlength="500" value="' . $e($val('note')) . '" placeholder="Đã bao gồm vật tư...">');

$html .= $field('isActive', 'Hiển thị', '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($isActiveChecked ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($isActiveChecked ? '' : ' selected') . '>Tắt</option></select>');

$html .= '<div class="form-actions">'
    . '<button class="btn btn-primary" type="submit">Lưu</button>'
    . '<a class="btn btn-ghost" href="' . $e($this->url('admin/pricing')) . '">Hủy</a></div>';

$html .= '</form></div>';

echo $html;
