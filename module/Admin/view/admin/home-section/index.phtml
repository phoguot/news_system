<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var list<\Admin\Model\HomeSection\HomeSectionModel> $items */
$items = (array) ($this->items ?? []);
/** @var array<int, string> $typeLabels */
$typeLabels = (array) ($this->typeLabels ?? []);
/** @var string|null $flag */
$flag    = isset($this->flag) && is_string($this->flag) ? $this->flag : null;
$csrf    = (string) ($this->csrfHash ?? '');
$reorderCsrf = (string) ($this->reorderCsrfHash ?? '');
$activeCsrf = (string) ($this->activeCsrfHash ?? '');
$e       = fn (mixed $v): string => $this->escapeHtml((string) $v);
$url     = fn (array $params = []): string => $this->url('admin/home-sections', $params);

$flags = [
    'created'  => ['alert-success', 'Đã tạo section.'],
    'updated'  => ['alert-success', 'Đã cập nhật section.'],
    'deleted'  => ['alert-success', 'Đã xoá section (kèm mục chọn tay nếu có).'],
    'csrf'     => ['alert-danger', 'Token bảo mật không hợp lệ.'],
    'notfound' => ['alert-danger', 'Không tìm thấy section trang chủ.'],
    'reordered' => ['alert-success', 'Đã cập nhật thứ tự section.'],
    'active-updated' => ['alert-success', 'Đã cập nhật hiển thị section.'],
];

$activeSelect = static function (int $id, int $current) use ($url, $e, $activeCsrf): string {
    $yes = $current === \Admin\Model\HomeSection\HomeSectionConst::ACTIVE ? ' selected' : '';
    $no  = $current === \Admin\Model\HomeSection\HomeSectionConst::ACTIVE ? '' : ' selected';

    return '<form class="inline-status-form" method="post" action="' . $e($url(['action' => 'active', 'id' => $id])) . '">'
        . '<input type="hidden" name="csrf" value="' . $e($activeCsrf) . '">'
        . '<select class="form-select status-select" name="isActive" onchange="this.form.submit()">'
        . '<option value="1"' . $yes . '>Có</option>'
        . '<option value="0"' . $no . '>Tắt</option></select></form>';
};

$html = '<div class="page-header"><div><h1>Bố cục trang chủ</h1>'
    . '<p class="subtitle">Các section hiển thị ở trang chủ — thứ tự, chế độ auto/manual.</p></div>'
    . '<a class="btn btn-primary" href="' . $url(['action' => 'create']) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">'
    . '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Thêm section</a></div>';

if ($flag !== null && isset($flags[$flag])) {
    [$cls, $msg] = $flags[$flag];
    $html .= '<div class="alert ' . $cls . '">' . $msg . '</div>';
}

$rowsHtml = '';
foreach ($items as $section) {
    /** @var \Admin\Model\HomeSection\HomeSectionModel $section */
    $id       = $section->id;
    $typeText = $typeLabels[$section->type] ?? ('type ' . $section->type);
    $statusSelect = $activeSelect((int) $id, (int) $section->isActive);
    $config   = $section->config ?? '—';
    if (mb_strlen($config) > 60) {
        $config = mb_substr($config, 0, 57) . '…';
    }

    $rowsHtml .= '<tr data-id="' . (int) $id . '">'
        . '<td class="drag-col"><span class="drag-handle" title="Kéo để đổi thứ tự">⠿</span></td>'
        . '<td><span class="tag-chip">' . $e($typeText) . '</span></td>'
        . '<td><strong>' . $e($section->title ?? '—') . '</strong></td>'
        . '<td class="muted mono" style="word-break:break-all">' . $e($config) . '</td>'
        . '<td class="muted sort-cell">' . $e($section->sortOrder) . '</td>'
        . '<td>' . $statusSelect . '</td>'
        . '<td><div class="actions">'
        . '<a class="btn sm btn-ghost" href="' . $url(['action' => 'edit', 'id' => $id]) . '">Sửa</a>'
        . '<form method="post" action="' . $url(['action' => 'delete', 'id' => $id]) . '"'
        . ' onsubmit="return confirm(\'Xoá vĩnh viễn section này? Các mục chọn tay (nếu có) cũng bị dọn theo.\');">'
        . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">'
        . '<button class="btn sm btn-ghost danger" type="submit">Xoá</button></form>'
        . '</div></td></tr>';
}

if ($items === []) {
    $rowsHtml = '<tr><td colspan="7" class="muted">Chưa có section nào.</td></tr>';
}

$html .= '<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr>'
    . '<th class="drag-col"></th><th>Loại</th><th>Tiêu đề</th><th>Config</th><th>Thứ tự</th>'
    . '<th>Hiển thị</th><th class="action-col">Thao tác</th>'
    . '</tr></thead><tbody class="js-sortable"'
    . ' data-reorder-url="' . $e($url(['action' => 'reorder'])) . '" data-csrf="' . $e($reorderCsrf) . '">'
    . $rowsHtml . '</tbody></table></div></div>';

$html .= '<p class="muted" style="font-size:12.5px">Kéo <span class="mono">⠿</span> để đổi thứ tự section (FR-32);'
    . ' chọn và xếp mục cho <span class="mono">mode=manual</span> vẫn làm qua form từng section (FR-33).</p>';

echo $html;
