<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var int|null $id */
$id     = isset($this->id) ? (int) $this->id : null;
/** @var array<array-key, mixed> $values */
$values = (array) ($this->values ?? []);
/** @var array<string, string> $errors */
$errors = (array) ($this->errors ?? []);
/** @var array<int, string> $typeLabels */
$typeLabels = (array) ($this->typeLabels ?? []);
$title  = (string) ($this->title ?? 'Section trang chủ');
$csrf   = (string) ($this->csrfHash ?? '');
$e      = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val    = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/home-sections', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));
$listUrl = $this->url('admin/home-sections');
$pageTitle = $id === null ? 'Thêm section' : $title;

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err  = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$flagValue = static function (string $key) use ($values): bool {
    $raw = $values[$key] ?? null;

    return ! ($raw === null || $raw === '' || $raw === 0 || $raw === '0' || $raw === false);
};

$panelIcon = static function (string $inner): string {
    return '<span class="form-panel-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"'
        . ' stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
        . $inner . '</svg></span>';
};

$currentType = is_numeric($val('type')) ? (int) $val('type') : \Admin\Model\HomeSection\HomeSectionConst::TYPE_FEATURED_POSTS;
$configRaw = $val('config');
$config = [];
if ($configRaw !== '') {
    $decoded = json_decode($configRaw, true);
    $config = is_array($decoded) ? $decoded : [];
}
$cfg = static fn (string $key, mixed $default = ''): mixed => $config[$key] ?? $default;
$cfgText = static fn (string $key, mixed $default = ''): string => (string) ($config[$key] ?? $default);
$cfgBool = static fn (string $key, bool $default = true): bool => array_key_exists($key, $config)
    ? (bool) $config[$key]
    : $default;
/** @var list<array{id: int, label: string}> $categoryOptions */
$categoryOptions = (array) ($this->categoryOptions ?? []);

$optionHtml = static function (array $options, string $current, string $placeholder) use ($e): string {
    $html = '<option value="">' . $e($placeholder) . '</option>';
    foreach ($options as $option) {
        $id = (string) ($option['id'] ?? '');
        if ($id === '') {
            continue;
        }
        $selected = $current === $id ? ' selected' : '';
        $html .= '<option value="' . $e($id) . '"' . $selected . '>' . $e($option['label'] ?? ('#' . $id)) . '</option>';
    }

    return $html;
};

$configError = isset($errors['config']) ? '<div class="field-error">' . $e($errors['config']) . '</div>' : '';
$modeOptions = '<option value="auto"' . ($cfgText('mode', 'auto') === 'auto' ? ' selected' : '') . '>Tự động</option>'
    . '<option value="manual"' . ($cfgText('mode') === 'manual' ? ' selected' : '') . '>Chọn thủ công</option>';
$autoplayOptions = '<option value="1"' . ($cfgBool('autoplay', true) ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($cfgBool('autoplay', true) ? '' : ' selected') . '>Không</option>';

$processRows = '';
$steps = $cfg('steps', []);
$steps = is_array($steps) ? array_values($steps) : [];
for ($i = 0; $i < 6; $i++) {
    $step = isset($steps[$i]) && is_array($steps[$i]) ? $steps[$i] : [];
    $processRows .= '<div class="home-step-row">'
        . '<input class="form-input" data-home-config-step-title placeholder="Tên bước ' . ($i + 1) . '" maxlength="80"'
        . ' value="' . $e((string) ($step['title'] ?? '')) . '">'
        . '<input class="form-input" data-home-config-step-desc placeholder="Mô tả ngắn" maxlength="300"'
        . ' value="' . $e((string) ($step['desc'] ?? '')) . '">'
        . '</div>';
}

$html = '<div class="entry-page"><div class="entry-page-head"><div>'
    . '<div class="breadcrumb"><a href="' . $e($listUrl) . '">Trang chủ</a><span>&rsaquo;</span><span>'
    . $e($pageTitle) . '</span></div>'
    . '<h1>' . $e($pageTitle) . '</h1>'
    . '<p class="subtitle">Thiết lập từng khối nội dung hiển thị trên trang chủ.</p></div>'
    . '<a class="btn btn-ghost entry-back" href="' . $e($listUrl) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>'
    . 'Quay lại danh sách</a></div>';

$html .= '<form class="entry-form js-home-config-form" method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$typeHtml = '<select class="form-select" id="f-type" name="type">';
foreach ($typeLabels as $typeCode => $typeLabel) {
    $selected = $currentType === (int) $typeCode ? ' selected' : '';
    $typeHtml .= '<option value="' . $e($typeCode) . '"' . $selected . '>' . $e($typeLabel) . '</option>';
}

$typeHtml .= '</select>';

$html .= '<div class="entry-form-grid"><div class="entry-main">';
$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>')
    . '<div><h2>Thông tin cơ bản</h2><p>Chọn loại section và nội dung tiêu đề.</p></div></div>';
$html .= '<div class="form-row cols-2">';
$html .= $field('type', 'Loại section *', $typeHtml);
$html .= $field(
    'title',
    'Tiêu đề',
    '<input class="form-input" id="f-title" name="title" maxlength="255" value="' . $e($val('title')) . '">'
);
$html .= $field(
    'subtitle',
    'Tiêu đề phụ',
    '<input class="form-input" id="f-subtitle" name="subtitle" maxlength="500"'
    . ' value="' . $e($val('subtitle')) . '">'
);
$html .= '</div></section>';
$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>')
    . '<div><h2>Cấu hình section</h2><p>Thiết lập dữ liệu riêng theo từng loại section.</p></div></div>';
$html .= '<div class="form-group config-builder">'
    . '<label for="f-config">Cấu hình section</label>'
    . '<input type="hidden" id="f-config" class="js-home-config-json" name="config" value="' . $e($configRaw) . '">'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_HERO_BANNER . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Tự chạy banner</label><select class="form-select" data-home-config-key="autoplay"'
    . ' data-home-config-type="bool">' . $autoplayOptions . '</select></div>'
    . '<div class="form-group"><label>Thời gian chuyển</label><input class="form-input" type="number" min="1000" max="60000" step="500"'
    . ' data-home-config-key="interval_ms" data-home-config-type="int" value="' . $e($cfgText('interval_ms', '5000')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_FEATURED_POSTS . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Chế độ lấy tin</label><select class="form-select" data-home-config-key="mode">' . $modeOptions . '</select></div>'
    . '<div class="form-group"><label>Số tin hiển thị</label><input class="form-input" type="number" min="1" max="50"'
    . ' data-home-config-key="limit" data-home-config-type="int" value="' . $e($cfgText('limit', '5')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_LATEST_POSTS . '">'
    . '<div class="form-row cols-2"><div class="form-group"><label>Số tin hiển thị</label>'
    . '<input class="form-input" type="number" min="1" max="50" data-home-config-key="limit" data-home-config-type="int"'
    . ' value="' . $e($cfgText('limit', '6')) . '"></div></div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_CATEGORY_POSTS . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Danh mục</label><select class="form-select" data-home-config-key="category_id"'
    . ' data-home-config-type="int">' . $optionHtml($categoryOptions, $cfgText('category_id'), '— Chọn danh mục —') . '</select></div>'
    . '<div class="form-group"><label>Số tin hiển thị</label><input class="form-input" type="number" min="1" max="50"'
    . ' data-home-config-key="limit" data-home-config-type="int" value="' . $e($cfgText('limit', '4')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_SERVICES . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Chế độ lấy dịch vụ</label><select class="form-select" data-home-config-key="mode">' . $modeOptions . '</select></div>'
    . '<div class="form-group"><label>Số dịch vụ hiển thị</label><input class="form-input" type="number" min="1" max="50"'
    . ' data-home-config-key="limit" data-home-config-type="int" value="' . $e($cfgText('limit', '6')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_TEAM . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Chế độ lấy nhân sự</label><select class="form-select" data-home-config-key="mode">' . $modeOptions . '</select></div>'
    . '<div class="form-group"><label>Số nhân sự hiển thị</label><input class="form-input" type="number" min="1" max="50"'
    . ' data-home-config-key="limit" data-home-config-type="int" value="' . $e($cfgText('limit', '4')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_CONTACT_CTA . '">'
    . '<div class="form-row cols-2">'
    . '<div class="form-group"><label>Chữ trên nút</label><input class="form-input" maxlength="255" data-home-config-key="button_text"'
    . ' value="' . $e($cfgText('button_text')) . '"></div>'
    . '<div class="form-group"><label>Đường dẫn nút</label><input class="form-input" maxlength="500" data-home-config-key="button_url"'
    . ' placeholder="/lien-he" value="' . $e($cfgText('button_url')) . '"></div>'
    . '</div></div>'
    . '<div class="home-config-panel" data-home-config-panel="' . \Admin\Model\HomeSection\HomeSectionConst::TYPE_PROCESS . '">'
    . '<div class="process-config-grid">' . $processRows . '</div>'
    . '</div>'
    . $configError
    . '</div></section></div><div class="entry-side">';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>')
    . '<div><h2>Tùy chọn hiển thị</h2><p>Thiết lập thứ tự và trạng thái section.</p></div></div>';
$html .= '<div class="form-row cols-2">';
$html .= $field(
    'sortOrder',
    'Thứ tự',
    '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="'
    . $e($val('sortOrder', '0')) . '">'
);
$html .= $field(
    'isActive',
    'Hiển thị',
    '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($flagValue('isActive') ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($flagValue('isActive') ? '' : ' selected') . '>Tắt</option></select>'
);
$html .= '</div><div class="notice-box"><strong>Lưu ý</strong>'
    . '<p>Section được lưu sẽ tự làm mới cache trang chủ để website nhận cấu hình mới.</p></div>';
$html .= '</section></div></div>';

$html .= '<div class="entry-form-actions">'
    . '<a class="btn btn-ghost" href="' . $e($listUrl) . '">Hủy</a>'
    . '<button class="btn btn-primary" type="submit">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>'
    . '<polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>'
    . 'Lưu section</button></div>';
$html .= '</form></div>';

/* ---- FR-33: quản mục cho section `mode=manual` (docs §4.4.4) ---- */
$flag        = (string) ($this->flag ?? '');
$items       = (array) ($this->items ?? []);
$itemLabels  = (array) ($this->itemLabels ?? []);
/** @var list<array{id: int, label: string}> $itemOptions */
$itemOptions = (array) ($this->itemOptions ?? []);
$itemsCsrf   = (string) ($this->itemsCsrfHash ?? '');
$manualMode  = (bool) ($this->manualMode ?? false);
$allowedType = isset($this->allowedItemType) && is_numeric($this->allowedItemType)
    ? (int) $this->allowedItemType
    : null;

$itemNameById = [];
foreach ($itemOptions as $opt) {
    $itemNameById[(int) $opt['id']] = (string) $opt['label'];
}

$itemsHtml = '';
if ($id !== null && $allowedType !== null) {
    $itemsUrl  = $this->url('admin/home-sections', ['action' => 'items', 'id' => $id]);
    $itemAlert = [
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_ADDED     => ['alert-success', 'Đã thêm mục vào section.'],
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_REMOVED   => ['alert-success', 'Đã xoá mục khỏi section.'],
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_MOVED     => ['alert-success', 'Đã đổi thứ tự mục.'],
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_DUPLICATE => ['alert-warning', 'Mục này đã nằm trong section.'],
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_MISSING   => ['alert-warning', 'Bản ghi được tham chiếu không tồn tại.'],
        \Admin\Model\HomeSection\HomeSectionConst::FLAG_ITEM_LIMIT     => ['alert-warning', 'Section đã đạt trần số mục cho phép.'],
        'csrf'                                => ['alert-danger',  'CSRF hết hạn — tải lại trang rồi thử lại.'],
        'invalid'                             => ['alert-danger',  'Dữ liệu thao tác mục không hợp lệ.'],
        'notfound'                            => ['alert-warning', 'Không tìm thấy mục trong section này.'],
    ];

    $itemsHtml = '<div class="card" style="max-width:760px;margin-top:20px">'
        . '<h3 style="font-size:.95rem;font-weight:700;margin-bottom:6px">Mục của section (mode=manual)</h3>';
    if ($flag !== '' && isset($itemAlert[$flag])) {
        $itemsHtml .= '<div class="alert ' . $itemAlert[$flag][0] . '">' . $e($itemAlert[$flag][1]) . '</div>';
    }

    if (! $manualMode) {
        $itemsHtml .= '<div class="field-hint">Section đang ở chế độ auto. Chuyển <span class="mono">config</span> sang'
            . ' <span class="mono">{"mode":"manual", …}</span> và lưu để chọn mục cụ thể (FR-33).</div>';
    } else {
        $itemsHtml .= '<div class="field-hint" style="margin-bottom:12px">Loại mục được phép ở đây:'
            . ' <strong>' . $e($itemLabels[$allowedType] ?? (string) $allowedType) . '</strong>'
            . ' — chọn bản ghi từ danh sách bên dưới.</div>';

        $rowHtml = '';
        foreach ($items as $item) {
            /** @var \Admin\Model\HomeSectionItem\HomeSectionItemModel $item */
            $rowLabel = $itemNameById[$item->itemId] ?? ('#' . $item->itemId);
            $rowHtml .= '<div class="list-row"><span>'
                . $e($itemLabels[$item->itemType] ?? '?')
                . ' <span class="tag-chip">' . $e($rowLabel) . '</span>'
                . ' <span class="muted" style="font-size:12px">sort ' . $e($item->sortOrder) . '</span></span>'
                . '<span class="row-actions">';
            $rowHtml .= '<form method="post" action="' . $e($itemsUrl) . '">';
            $rowHtml .= '<input type="hidden" name="csrf" value="' . $e($itemsCsrf) . '">';
            $rowHtml .= '<input type="hidden" name="id" value="' . $e($item->id) . '">';
            $rowHtml .= '<button class="btn sm btn-ghost" type="submit" name="op" value="up" title="Lên">↑</button>';
            $rowHtml .= '<button class="btn sm btn-ghost" type="submit" name="op" value="down" title="Xuống">↓</button>';
            $rowHtml .= '<button class="btn sm btn-ghost danger" type="submit" name="op" value="remove">Xoá</button>';
            $rowHtml .= '</form></span></div>';
        }

        $itemsHtml .= $rowHtml === ''
            ? '<p class="muted" style="margin-bottom:12px">Chưa có mục nào — thêm bằng form bên dưới.</p>'
            : $rowHtml;

        $itemsHtml .= '<form method="post" action="' . $e($itemsUrl) . '" class="toolbar-form" style="margin:12px 0 0">'
            . '<input type="hidden" name="csrf" value="' . $e($itemsCsrf) . '">'
            . '<input type="hidden" name="op" value="add">'
            . '<input type="hidden" name="itemType" value="' . $e($allowedType) . '">'
            . '<label for="f-itemId" style="font-size:13px;font-weight:600">'
            . $e($itemLabels[$allowedType] ?? 'Mục') . '</label>'
            . $this->selectField(
                'itemId',
                $itemOptions,
                '',
                true,
                '— Chọn ' . strtolower((string) ($itemLabels[$allowedType] ?? 'mục')) . ' —'
            )
            . '<button class="btn btn-ghost sm" type="submit">+ Thêm mục</button>'
            . '</form>';
    }

    $itemsHtml .= '</div>';
}

echo $html . $itemsHtml;
