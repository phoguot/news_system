<?php /** @var \Laminas\View\Renderer\PhpRenderer $this */

/** @var array<string, string> $errors */
$errors   = isset($this->errors) && is_array($this->errors) ? $this->errors : [];
$sent     = (bool) ($this->sent ?? false);
$csrfHash = (string) ($this->csrfHash ?? '');

$e = static fn (mixed $v): string => htmlspecialchars((string) $v, ENT_QUOTES | ENT_HTML5, 'UTF-8');
$urlForgot = (string) $this->url('admin/forgot-password');

$fieldError = static function (string $field) use ($errors, $e): string {
    $msg = $errors[$field] ?? null;

    return is_string($msg) && $msg !== '' ? '<p class="form-error">' . $e($msg) . '</p>' : '';
};

// PRG flag sent = true → cùng template, không redirect vô hạn
$noticeHtml = $sent
    ? '<div class="alert alert-success">Nếu email tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu. '
        . 'Vui lòng kiểm tra hộp thư (kể cả thư rác) — liên kết hết hạn sau 60 phút.</div>'
    : '';
$emailError = $errors['email'] ?? $errors['csrf'] ?? null;
$alertHtml  = is_string($emailError) && $emailError !== '' && ! $sent
    ? '<div class="alert visible"><span>' . $e($emailError) . '</span></div>'
    : '';
?>
