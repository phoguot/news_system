        <?php $formBody = '<form method="post" action="' . $e($urlForgot) . '">'
            . '<input type="hidden" name="csrf" value="' . $e($csrfHash) . '">'
            . '<div class="form-group"><label class="form-label" for="email">Email</label>'
            . '<input type="email" id="email" name="email" class="form-input' . (isset($errors['email']) ? ' error' : '') . '" placeholder="admin@vanlang.vn" required autocomplete="email">'
            . $fieldError('email') . '</div>'
            . '<button type="submit" class="btn-login">Gửi liên kết đặt lại</button></form>'
            . '<a href="' . $e((string) $this->url('admin/login')) . '" class="back-home">← Quay lại đăng nhập</a>'; ?>
