            . '<div class="form-group"><label class="form-label" for="confirmPassword">Nhập lại mật khẩu</label>'
            . '<input type="password" id="confirmPassword" name="confirmPassword" class="form-input' . (isset($errors['confirmPassword']) ? ' error' : '') . '" required autocomplete="new-password">'
            . $fieldError('confirmPassword') . '</div>'
            . '<button type="submit" class="btn-login">Đổi mật khẩu</button></form>'
            . '<a href="' . $e((string) $this->url('admin/login')) . '" class="back-home">← Quay lại đăng nhập</a>'; ?>
