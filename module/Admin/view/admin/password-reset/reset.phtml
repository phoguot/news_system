        <?php $formBody = '<form method="post" action="' . $e($urlReset) . '">'
            . '<input type="hidden" name="csrf" value="' . $e($csrfHash) . '">'
            . '<input type="hidden" name="token" value="' . $e($token) . '">'
            . '<div class="form-group"><label class="form-label" for="password">Mật khẩu mới</label>'
            . '<input type="password" id="password" name="password" class="form-input' . (isset($errors['password']) ? ' error' : '') . '" required autocomplete="new-password">'
