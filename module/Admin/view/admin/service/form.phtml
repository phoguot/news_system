<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var int|null $id */
$id     = isset($this->id) ? (int) $this->id : null;
/** @var array<array-key, mixed> $values */
$values = (array) ($this->values ?? []);
/** @var array<string, string> $errors */
$errors = (array) ($this->errors ?? []);
/** @var list<array{id: int, label: string, path: string}> $mediaOptions */
$mediaOptions = (array) ($this->mediaOptions ?? []);
$title  = (string) ($this->title ?? 'Dịch vụ');
$csrf   = (string) ($this->csrfHash ?? '');
$e      = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val    = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/services', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err  = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$active          = $values['isActive'] ?? 1;
$isActiveChecked = ! ($active === 0 || $active === '0' || $active === false);

$html = '<div class="page-header"><div><h1>' . $e($title) . '</h1>'
    . '<p class="subtitle">Quay lại <a href="' . $e($this->url('admin/services')) . '">danh sách dịch vụ</a>.</p></div></div>';

$html .= '<div class="card"><form method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="form-row cols-2">';
$html .= $field(
    'name',
    'Tên dịch vụ *',
    '<input class="form-input" id="f-name" name="name" maxlength="150" required value="' . $e($val('name')) . '">'
);
$html .= $field(
    'slug',
    'Slug',
    '<input class="form-input mono" id="f-slug" name="slug" maxlength="255" value="' . $e($val('slug')) . '"'
    . ' placeholder="de-trong-tu-sinh">',
    'Để trống = tự sinh từ tên.'
);
$html .= '</div>';

$parentOptions = (array) ($this->parentOptions ?? []);
$parentValue   = (string) ($values['parentId'] ?? '');
$parentSelect  = '<select class="form-select" id="f-parentId" name="parentId">'
    . '<option value="">— Không (dịch vụ cha) —</option>';
foreach ($parentOptions as $pid => $plabel) {
    $sel = (string) $pid === $parentValue ? ' selected' : '';
    $parentSelect .= '<option value="' . $e($pid) . '"' . $sel . '>' . $e($plabel) . '</option>';
}
$parentSelect .= '</select>';
$html .= $field('parentId', 'Dịch vụ cha', $parentSelect, 'Chọn dịch vụ cha (Chăm sóc tại viện / tại nhà). Để trống = dịch vụ cha.');

$html .= $field(
    'shortDescription',
    'Mô tả ngắn',
    '<textarea class="form-textarea" id="f-shortDescription" name="shortDescription" rows="2" maxlength="500"'
    . ' placeholder="Một hai câu giới thiệu hiển thị ở thẻ dịch vụ">' . $e($val('shortDescription')) . '</textarea>'
);

$html .= $field(
    'content',
    'Nội dung chi tiết',
    '<textarea class="form-textarea" id="f-content" name="content" rows="10" data-wysiwyg'
    . ' placeholder="Soạn nội dung chi tiết dịch vụ…">' . $e($val('content')) . '</textarea>'
);

$html .= '<div class="form-row cols-4">';
$html .= $field(
    'iconMediaId',
    'Icon',
    $this->mediaPicker('iconMediaId', $mediaOptions, $val('iconMediaId'))
);
$html .= $field(
    'imageMediaId',
    'Ảnh minh hoạ',
    $this->mediaPicker('imageMediaId', $mediaOptions, $val('imageMediaId'))
);
$html .= $field(
    'sortOrder',
    'Thứ tự',
    '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="'
    . $e($val('sortOrder', '0')) . '">'
);
$html .= $field(
    'isActive',
    'Hiển thị',
    '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($isActiveChecked ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($isActiveChecked ? '' : ' selected') . '>Tắt</option></select>'
);
$html .= '</div>';

$html .= '<div class="form-row cols-2">';
$html .= $field(
    'metaTitle',
    'Meta title',
    '<input class="form-input" id="f-metaTitle" name="metaTitle" maxlength="255"'
    . ' value="' . $e($val('metaTitle')) . '">'
);
$html .= $field(
    'metaDescription',
    'Meta description',
    '<input class="form-input" id="f-metaDescription" name="metaDescription" maxlength="500"'
    . ' value="' . $e($val('metaDescription')) . '">'
);
$html .= '</div>';

$html .= '<div class="form-actions">'
    . '<button class="btn btn-primary" type="submit">Lưu</button>'
    . '<a class="btn btn-ghost" href="' . $e($this->url('admin/services')) . '">Hủy</a></div>';

$html .= '</form></div>';

echo $html;
