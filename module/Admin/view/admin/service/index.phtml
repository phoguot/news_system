<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var list<\Frontend\Model\Service\ServiceModel> $items */
$items = (array) ($this->items ?? []);
/** @var string|null $flag */
$flag    = isset($this->flag) && is_string($this->flag) ? $this->flag : null;
$csrf    = (string) ($this->csrfHash ?? '');
$reorderCsrf = (string) ($this->reorderCsrfHash ?? '');
$e       = fn (mixed $v): string => $this->escapeHtml((string) $v);
$url     = fn (array $params = []): string => $this->url('admin/services', $params);

$flags = [
    'created'  => ['alert-success', 'Đã tạo dịch vụ.'],
    'updated'  => ['alert-success', 'Đã cập nhật dịch vụ.'],
    'deleted'  => ['alert-success', 'Đã xoá dịch vụ.'],
    'blocked'  => ['alert-warning', 'Không thể xoá: còn lượt liên hệ tham chiếu dịch vụ này.'],
    'csrf'     => ['alert-danger', 'Token bảo mật không hợp lệ.'],
    'notfound' => ['alert-danger', 'Không tìm thấy dịch vụ.'],
    'reordered' => ['alert-success', 'Đã cập nhật thứ tự dịch vụ.'],
];

$html = '<div class="page-header"><div><h1>Dịch vụ</h1>'
    . '<p class="subtitle">Danh mục dịch vụ hiển thị ở trang giới thiệu và form liên hệ.</p></div>'
    . '<a class="btn btn-primary" href="' . $url(['action' => 'create']) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">'
    . '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Thêm dịch vụ</a></div>';

if ($flag !== null && isset($flags[$flag])) {
    [$cls, $msg] = $flags[$flag];
    $html .= '<div class="alert ' . $cls . '">' . $msg . '</div>';
}

$rowsHtml = '';
foreach ($items as $service) {
    /** @var \Frontend\Model\Service\ServiceModel $service */
    $id    = $service->id;
    $badge = $service->isActive === \Frontend\Model\Service\ServiceConst::ACTIVE
        ? '<span class="status published">Có</span>'
        : '<span class="status off">Tắt</span>';

    $rowsHtml .= '<tr data-id="' . (int) $id . '">'
        . '<td class="drag-col"><span class="drag-handle" title="Kéo để đổi thứ tự">⠿</span></td>'
        . '<td><div class="service-cell"><span><strong>' . $e($service->name) . '</strong></span></div></td>'
        . '<td><span class="slug-text">' . $e($service->slug) . '</span></td>'
        . '<td class="muted sort-cell">' . $e($service->sortOrder) . '</td>'
        . '<td>' . $badge . '</td>'
        . '<td><div class="actions">'
        . '<a class="btn sm btn-ghost" href="' . $url(['action' => 'edit', 'id' => $id]) . '">Sửa</a>'
        . '<form method="post" action="' . $url(['action' => 'delete', 'id' => $id]) . '"'
        . ' onsubmit="return confirm(\'Xoá vĩnh viễn dịch vụ này? Không thể khôi phục.\');">'
        . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">'
        . '<button class="btn sm btn-ghost danger" type="submit">Xoá</button></form>'
        . '</div></td></tr>';
}

if ($items === []) {
    $rowsHtml = '<tr><td colspan="6" class="muted">Chưa có dịch vụ nào.</td></tr>';
}

$html .= '<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr>'
    . '<th class="drag-col"></th><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Hiển thị</th><th class="action-col">Thao tác</th>'
    . '</tr></thead><tbody class="js-sortable"'
    . ' data-reorder-url="' . $e($url(['action' => 'reorder'])) . '" data-csrf="' . $e($reorderCsrf) . '">'
    . $rowsHtml . '</tbody></table></div></div>';

echo $html;
