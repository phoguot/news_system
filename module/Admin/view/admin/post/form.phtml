<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var int|null $id */
$id     = isset($this->id) ? (int) $this->id : null;
/** @var array<array-key, mixed> $values */
$values = (array) ($this->values ?? []);
/** @var array<string, string> $errors */
$errors = (array) ($this->errors ?? []);
/** @var list<array{id: int, label: string}> $categoryOptions */
$categoryOptions = (array) ($this->categoryOptions ?? []);
/** @var list<array{id: int, label: string, path: string}> $mediaOptions */
$mediaOptions = (array) ($this->mediaOptions ?? []);
/** @var int|null $status */
$status = isset($this->status) && is_numeric($this->status) ? (int) $this->status : null;
$title  = (string) ($this->title ?? 'Bài viết');
$csrf   = (string) ($this->csrfHash ?? '');
$e      = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val    = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/posts', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));
$listUrl = $this->url('admin/posts');
$pageTitle = $id === null ? 'Thêm bài viết' : $title;

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err  = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$panelIcon = static function (string $inner): string {
    return '<span class="form-panel-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"'
        . ' stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
        . $inner . '</svg></span>';
};

$statusHtml = '';
if ($status !== null) {
    $labels = [
        \Application\Constant\ContentConst::STATUS_DRAFT     => ['draft', 'Nháp'],
        \Application\Constant\ContentConst::STATUS_PUBLISHED => ['published', 'Đã xuất bản'],
        \Application\Constant\ContentConst::STATUS_ARCHIVED  => ['archived', 'Lưu trữ'],
    ];
    [$cls, $label] = $labels[$status] ?? ['draft', 'Không rõ'];
    $statusHtml = '<span class="status ' . $cls . '">' . $e($label) . '</span>';
}

$catHtml = '<select class="form-select" id="f-categoryId" name="categoryId" required>'
    . '<option value="">— Chọn chuyên mục —</option>';
foreach ($categoryOptions as $opt) {
    $selected = (string) $opt['id'] === $val('categoryId') ? ' selected' : '';
    $catHtml .= '<option value="' . $e($opt['id']) . '"' . $selected . '>' . $e($opt['label']) . '</option>';
}
$catHtml .= '</select>';

$html = '<div class="entry-page"><div class="entry-page-head"><div>'
    . '<div class="breadcrumb"><a href="' . $e($listUrl) . '">Bài viết</a><span>&rsaquo;</span><span>'
    . $e($pageTitle) . '</span></div>'
    . '<h1>' . $e($pageTitle) . '</h1>'
    . '<p class="subtitle">Soạn nội dung, gắn chuyên mục và cấu hình xuất bản.</p></div>'
    . '<div class="entry-head-actions">' . $statusHtml
    . '<a class="btn btn-ghost entry-back" href="' . $e($listUrl) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>'
    . 'Quay lại danh sách</a></div></div>';

$html .= '<form class="entry-form" method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="entry-form-grid"><div class="entry-main">';
$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>')
    . '<div><h2>Thông tin bài viết</h2><p>Nhập tiêu đề, mô tả và nội dung chính.</p></div></div>';
$html .= $field(
    'title',
    'Tiêu đề bài viết *',
    '<input class="form-input" id="f-title" name="title" maxlength="255" required'
    . ' placeholder="Nhập tiêu đề bài viết" value="' . $e($val('title')) . '">'
);
$html .= $field(
    'excerpt',
    'Mô tả',
    '<textarea class="form-textarea sm" id="f-excerpt" name="excerpt" rows="3" maxlength="500"'
    . ' placeholder="Đoạn mở đầu hiển thị ở danh sách...">' . $e($val('excerpt')) . '</textarea>'
);
$html .= $field(
    'content',
    'Nội dung *',
    '<textarea class="form-textarea" id="f-content" name="content" rows="16" required data-wysiwyg'
    . ' placeholder="Soạn nội dung bài viết…">' . $e($val('content')) . '</textarea>',
    'Soạn thảo trực tiếp; HTML sẽ được lọc mã độc khi lưu.'
);
$html .= '</section>';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>')
    . '<div><h2>Ảnh bài viết</h2><p>Chọn ảnh banner và thumbnail cho danh sách.</p></div></div>'
    . '<div class="form-row cols-2">';
$html .= $field(
    'bannerMediaId',
    'Ảnh banner',
    $this->mediaPicker('bannerMediaId', $mediaOptions, $val('bannerMediaId')),
    'Bắt buộc chọn khi bấm Xuất bản.'
);
$html .= $field(
    'thumbnailMediaId',
    'Ảnh thumbnail',
    $this->mediaPicker('thumbnailMediaId', $mediaOptions, $val('thumbnailMediaId'))
);
$html .= '</div></section></div><div class="entry-side">';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>')
    . '<div><h2>Phân loại</h2><p>Gắn chuyên mục, slug và tag cho bài viết.</p></div></div>';
$html .= $field('categoryId', 'Chuyên mục *', $catHtml);
$html .= $field(
    'slug',
    'Slug',
    '<input class="form-input mono" id="f-slug" name="slug" maxlength="255"'
    . ' value="' . $e($val('slug')) . '" placeholder="de-trong-tu-sinh">',
    'Để trống = tự sinh từ tiêu đề.'
);
$html .= $field(
    'tags',
    'Tag',
    '<input class="form-input" id="f-tags" name="tags" autocomplete="off"'
    . ' data-tag-search="' . $e($this->url('admin-api', ['resource' => 'tags'])) . '"'
    . ' value="' . $e($val('tags')) . '" placeholder="Hà Nội, ẩm thực, …">',
    'Gõ để gợi ý tag đã có; phân tách bằng dấu phẩy.'
);
$html .= '</section>';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>')
    . '<div><h2>Xuất bản</h2><p>Lưu nháp, hẹn giờ hoặc xuất bản bài viết.</p></div></div>';
$html .= $field(
    'publishedAt',
    'Hẹn giờ (giờ VN)',
    '<input class="form-input" id="f-publishedAt" name="publishedAt" type="datetime-local" value="'
    . $e($val('publishedAt')) . '">',
    'Chỉ dùng với nút “Hẹn giờ”.'
);
$html .= $field(
    'isFeatured',
    'Nổi bật trang chủ',
    '<select class="form-select" id="f-isFeatured" name="isFeatured">'
    . '<option value="0"' . ($val('isFeatured') === '1' ? '' : ' selected') . '>Không</option>'
    . '<option value="1"' . ($val('isFeatured') === '1' ? ' selected' : '') . '>Có</option></select>'
);
$html .= '<div class="entry-publish-actions">'
    . '<button class="btn btn-ghost" type="submit" name="intent" value="draft" formnovalidate="formnovalidate">Lưu nháp</button>'
    . '<button class="btn btn-warn" type="submit" name="intent" value="schedule">Hẹn giờ</button>'
    . '<button class="btn btn-primary" type="submit" name="intent" value="publish">Xuất bản</button></div>';
$html .= '</section>';

$html .= '<section class="form-panel"><div class="form-panel-head">'
    . $panelIcon('<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>')
    . '<div><h2>SEO (Tối ưu tìm kiếm)</h2><p>Thông tin hiển thị trên công cụ tìm kiếm.</p></div></div>';
$html .= $field(
    'metaTitle',
    'Meta title',
    '<input class="form-input" id="f-metaTitle" name="metaTitle" maxlength="255"'
    . ' placeholder="Nhập meta title" value="' . $e($val('metaTitle')) . '">'
);
$html .= $field(
    'metaDescription',
    'Meta description',
    '<textarea class="form-textarea sm" id="f-metaDescription" name="metaDescription" rows="3" maxlength="500"'
    . ' placeholder="Nhập meta description">' . $e($val('metaDescription')) . '</textarea>'
);
$html .= '</section></div></div>';

$html .= '<div class="entry-form-actions">'
    . '<a class="btn btn-ghost" href="' . $e($listUrl) . '">Hủy</a>'
    . '<button class="btn btn-primary" type="submit" name="intent" value="publish">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
    . '<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>'
    . '<polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>'
    . 'Lưu & xuất bản</button></div>';

$html .= '</form>';

if ($id !== null) {
    $autosaveUrl = $this->url('admin-api', ['resource' => 'posts', 'id' => $id, 'sub' => 'autosave']);
    $revisionsUrl = $this->url('admin/posts', ['action' => 'revisions', 'id' => $id]);
    $html .= '<div id="autosave-bar" class="autosave-bar" data-autosave-url="' . $e($autosaveUrl) . '"'
        . ' data-post-id="' . $e((string) $id) . '"></div>';
    $html .= '<section class="form-panel revisions-panel"><div class="form-panel-head">'
        . $panelIcon('<path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/>')
        . '<div><h2>Lịch sử phiên bản</h2><p>Tự lưu mỗi 60 giây khi có thay đổi.</p></div></div>'
        . '<p><a class="btn btn-ghost" href="' . $e($revisionsUrl) . '">Xem lịch sử & khôi phục</a></p>';

    /** @var \Admin\Model\PostRevision\PostRevisionModel[]|null $revisions */
    $revisions = $this->revisions ?? null;
    if (is_array($revisions) && $revisions !== []) {
        $html .= '<ul class="revision-list">';
        $revActionCsrf = (string) ($this->revisionActionCsrf ?? $csrf);
        $restoreUrl = $this->url('admin/posts', ['action' => 'restore', 'id' => $id]);
        foreach (array_slice($revisions, 0, 8) as $rev) {
            $label = match ((int) $rev->type) {
                \Admin\Model\PostRevision\PostRevisionMapper::TYPE_AUTOSAVE => 'Tự lưu',
                \Admin\Model\PostRevision\PostRevisionMapper::TYPE_BEFORE_PUBLISH => 'Trước xuất bản',
                default => 'Thủ công',
            };
            $html .= '<li><span class="revision-date">' . $e($rev->createdAt) . '</span>'
                . '<span class="status draft">' . $e($label) . '</span>'
                . '<span class="revision-title">' . $e($rev->title) . '</span>'
                . '<button type="button" class="btn btn-ghost js-rev-compare"'
                . ' data-title="' . $e($rev->title) . '"'
                . ' data-excerpt="' . $e($rev->excerpt ?? '') . '"'
                . ' data-content="' . $e($rev->content) . '">So sánh</button>'
                . '<form method="post" action="' . $e($restoreUrl) . '" style="display:inline"'
                . ' onsubmit="return confirm(\'Khôi phục phiên bản này? Bản hiện tại sẽ được lưu thành revision mới.\')">'
                . '<input type="hidden" name="csrf" value="' . $e($revActionCsrf) . '">'
                . '<input type="hidden" name="revisionId" value="' . $e((string) $rev->id) . '">'
                . '<button class="btn btn-warn" type="submit">Khôi phục</button></form></li>';
        }
        $html .= '</ul>';
    } elseif (is_array($revisions)) {
        $html .= '<p class="subtitle" style="margin-top:8px">Chưa có bản lưu nào.</p>';
    }
    $html .= '</section>';
}

$html .= '</div>';

echo $html;
