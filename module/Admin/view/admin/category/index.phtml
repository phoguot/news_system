<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var list<array{category: \Admin\Model\Category\CategoryModel, depth: int}> $items */
$items = (array) ($this->items ?? []);
/** @var string|null $flag */
$flag    = isset($this->flag) && is_string($this->flag) ? $this->flag : null;
$csrf    = (string) ($this->csrfHash ?? '');
$reorderCsrf = (string) ($this->reorderCsrfHash ?? '');
$activeCsrf = (string) ($this->activeCsrfHash ?? '');
$e       = fn (mixed $v): string => $this->escapeHtml((string) $v);
$url     = fn (array $params = []): string => $this->url('admin/categories', $params);

$flags = [
    'created'  => ['alert-success', 'Đã tạo danh mục.'],
    'updated'  => ['alert-success', 'Đã cập nhật danh mục.'],
    'deleted'  => ['alert-success', 'Đã xoá danh mục.'],
    'blocked'  => ['alert-warning', 'Không thể xoá: danh mục còn danh mục con hoặc còn bài viết.'],
    'csrf'     => ['alert-danger', 'Token bảo mật không hợp lệ.'],
    'notfound' => ['alert-danger', 'Không tìm thấy danh mục.'],
    'reordered' => ['alert-success', 'Đã cập nhật thứ tự danh mục.'],
    'active-updated' => ['alert-success', 'Đã cập nhật hiển thị danh mục.'],
];

$activeSelect = static function (int $id, int $current) use ($url, $e, $activeCsrf): string {
    $yes = $current === \Admin\Model\Category\CategoryConst::ACTIVE ? ' selected' : '';
    $no  = $current === \Admin\Model\Category\CategoryConst::ACTIVE ? '' : ' selected';

    return '<form class="inline-status-form" method="post" action="' . $e($url(['action' => 'active', 'id' => $id])) . '">'
        . '<input type="hidden" name="csrf" value="' . $e($activeCsrf) . '">'
        . '<select class="form-select status-select" name="isActive" onchange="this.form.submit()">'
        . '<option value="1"' . $yes . '>Có</option>'
        . '<option value="0"' . $no . '>Tắt</option></select></form>';
};

$html = '<div class="page-header"><div><h1>Danh mục</h1>'
    . '<p class="subtitle">Cây chuyên mục tổ chức bài viết (tối đa 2 cấp).</p></div>'
    . '<a class="btn btn-primary" href="' . $url(['action' => 'create']) . '">'
    . '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">'
    . '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Thêm danh mục</a></div>';

if ($flag !== null && isset($flags[$flag])) {
    [$cls, $msg] = $flags[$flag];
    $html .= '<div class="alert ' . $cls . '">' . $msg . '</div>';
}

$html .= '<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr>'
    . '<th class="drag-col"></th><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Hiển thị</th><th class="action-col">Thao tác</th>'
    . '</tr></thead><tbody class="js-sortable" data-tree="1"'
    . ' data-reorder-url="' . $e($url(['action' => 'reorder'])) . '" data-csrf="' . $e($reorderCsrf) . '">';

$rowsHtml = '';
foreach ($items as $item) {
    /** @var \Admin\Model\Category\CategoryModel $category */
    $category = $item['category'];
    $id       = $category->id;
    $pad      = $item['depth'] === 1 ? 'padding-left:2rem;' : '';
    $name     = $item['depth'] === 1 ? '└ ' : '';
    $statusSelect = $activeSelect((int) $id, (int) $category->isActive);
    // data-parent rỗng ở cấp 1, = id cha ở cấp 2 → JS kéo-thả giữ đúng cấu trúc cây.
    $parentAttr = $category->parentId !== null ? (string) (int) $category->parentId : '';

    $rowsHtml .= '<tr data-id="' . (int) $id . '" data-parent="' . $e($parentAttr) . '">'
        . '<td class="drag-col"><span class="drag-handle" title="Kéo để đổi thứ tự">⠿</span></td>'
        . '<td style="' . $pad . '"><strong>' . $e($name . $category->name) . '</strong></td>'
        . '<td><span class="slug-text">' . $e($category->slug) . '</span></td>'
        . '<td class="muted sort-cell">' . $e($category->sortOrder) . '</td>'
        . '<td>' . $statusSelect . '</td>'
        . '<td><div class="actions">'
        . '<a class="btn sm btn-ghost" href="' . $url(['action' => 'edit', 'id' => $id]) . '">Sửa</a>'
        . '<form method="post" action="' . $url(['action' => 'delete', 'id' => $id]) . '"'
        . ' onsubmit="return confirm(\'Xoá vĩnh viễn danh mục này? Không thể khôi phục.\');">'
        . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">'
        . '<button class="btn sm btn-ghost danger" type="submit">Xoá</button></form>'
        . '</div></td></tr>';
}

if ($items === []) {
    $rowsHtml = '<tr><td colspan="6" class="muted">Chưa có danh mục nào.</td></tr>';
}

$html .= $rowsHtml . '</tbody></table></div></div>';

echo $html;
