<?php

/** @var \Laminas\View\Renderer\PhpRenderer $this */
/** @var int|null $id */
$id     = isset($this->id) ? (int) $this->id : null;
/** @var array<array-key, mixed> $values */
$values = (array) ($this->values ?? []);
/** @var array<string, string> $errors */
$errors = (array) ($this->errors ?? []);
/** @var list<array{id: int, label: string, path: string}> $mediaOptions */
$mediaOptions = (array) ($this->mediaOptions ?? []);
$title  = (string) ($this->title ?? 'Thành viên');
$csrf   = (string) ($this->csrfHash ?? '');
$e      = fn (mixed $v): string => $this->escapeHtml((string) $v);
$val    = static fn (string $key, mixed $default = ''): string => (string) ($values[$key] ?? $default);
$actionUrl = $this->url('admin/team', array_merge(['action' => 'save'], $id !== null ? ['id' => $id] : []));

$field = static function (string $name, string $label, string $control, string $hint = '') use ($errors, $e): string {
    $err  = isset($errors[$name]) ? '<div class="field-error">' . $e($errors[$name]) . '</div>' : '';
    $hintHtml = $hint !== '' ? '<div class="field-hint">' . $hint . '</div>' : '';

    return '<div class="form-group"><label for="f-' . $name . '">' . $e($label) . '</label>'
        . $control . $hintHtml . $err . '</div>';
};

$flagValue  = static function (string $key) use ($values): bool {
    $raw = $values[$key] ?? null;

    return ! ($raw === null || $raw === '' || $raw === 0 || $raw === '0' || $raw === false);
};

$html = '<div class="page-header"><div><h1>' . $e($title) . '</h1>'
    . '<p class="subtitle">Quay lại <a href="' . $e($this->url('admin/team')) . '">danh sách đội ngũ</a>.</p></div></div>';

$html .= '<div class="card"><form method="post" action="' . $e($actionUrl) . '">'
    . '<input type="hidden" name="csrf" value="' . $e($csrf) . '">';

$html .= '<div class="form-row cols-2">';
$html .= $field(
    'fullName',
    'Họ tên *',
    '<input class="form-input" id="f-fullName" name="fullName" maxlength="150" required value="' . $e($val('fullName')) . '">'
);
$html .= $field(
    'positionTitle',
    'Chức danh *',
    '<input class="form-input" id="f-positionTitle" name="positionTitle" maxlength="150" required'
    . ' value="' . $e($val('positionTitle')) . '">'
);
$html .= '</div>';

$html .= $field(
    'avatarMediaId',
    'Ảnh đại diện',
    $this->mediaPicker('avatarMediaId', $mediaOptions, $val('avatarMediaId'))
);

$html .= $field(
    'bio',
    'Tiểu sử',
    '<textarea class="form-textarea" id="f-bio" name="bio" rows="4">' . $e($val('bio')) . '</textarea>'
);

$html .= '<div class="form-row cols-2">';
$html .= $field(
    'email',
    'Email',
    '<input class="form-input" id="f-email" name="email" type="email" maxlength="255" value="' . $e($val('email')) . '">'
);
$html .= $field(
    'phone',
    'Điện thoại',
    '<input class="form-input" id="f-phone" name="phone" maxlength="20" value="' . $e($val('phone')) . '">'
);
$html .= '</div>';

$html .= $field(
    'userId',
    'Tài khoản CMS',
    '<input class="form-input" id="f-userId" name="userId" type="number" min="1" value="' . $e($val('userId')) . '">',
    'ID tài khoản để liên kết (trống = không liên kết, unique).'
);

$html .= $field(
    'socialLinks',
    'Mạng xã hội',
    '<textarea class="form-textarea" id="f-socialLinks" name="socialLinks" rows="3" placeholder="{&quot;facebook&quot;:&quot;https://...&quot;}">' . $e($val('socialLinks')) . '</textarea>',
    'JSON object: key là tên mạng, value là URL https.'
);

$html .= '<div class="form-row cols-4">';
$html .= $field(
    'showContact',
    'Hiện liên hệ',
    '<select class="form-select" id="f-showContact" name="showContact">'
    . '<option value="1"' . ($flagValue('showContact') ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($flagValue('showContact') ? '' : ' selected') . '>Không</option></select>'
);
$html .= $field(
    'isFeatured',
    'Nổi bật',
    '<select class="form-select" id="f-isFeatured" name="isFeatured">'
    . '<option value="1"' . ($flagValue('isFeatured') ? ' selected' : '') . '>★ Có</option>'
    . '<option value="0"' . ($flagValue('isFeatured') ? '' : ' selected') . '>Không</option></select>'
);
$html .= $field(
    'isActive',
    'Hiển thị',
    '<select class="form-select" id="f-isActive" name="isActive">'
    . '<option value="1"' . ($flagValue('isActive') ? ' selected' : '') . '>Có</option>'
    . '<option value="0"' . ($flagValue('isActive') ? '' : ' selected') . '>Tắt</option></select>'
);
$html .= $field(
    'sortOrder',
    'Thứ tự',
    '<input class="form-input" id="f-sortOrder" name="sortOrder" type="number" value="'
    . $e($val('sortOrder', '0')) . '">'
);
$html .= '</div>';

$html .= '<div class="form-actions">'
    . '<button class="btn btn-primary" type="submit">Lưu</button>'
    . '<a class="btn btn-ghost" href="' . $e($this->url('admin/team')) . '">Hủy</a></div>';

$html .= '</form></div>';

echo $html;
