<?php

declare(strict_types=1);

/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array<string, string> $groups
 * @var list<array<string, mixed>> $groupBlocks
 */
$groups = is_array($this->groups ?? null) ? $this->groups : [];
$blocks = is_array($this->groupBlocks ?? null) ? $this->groupBlocks : [];
$total = (int) ($this->total ?? 0);
$group = (string) ($this->group ?? '');
$q = (string) ($this->q ?? '');
$contact = $this->siteContact();
$this->headTitle('Bảng giá · Văn Lang');
$view = $this;
$e = static fn (mixed $value): string => $view->escapeHtml((string) $value);
$ea = static fn (mixed $value): string => $view->escapeHtmlAttr((string) $value);
$bannerImage = $this->basePath('assets/img/banner-bang-gia-v2.jpg');
$bannerMobile = $this->basePath('assets/img/banner-bang-gia-mobile-v2.jpg');

$breadcrumb = '<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a>'
    . '<span> › </span><span aria-current="page">Bảng giá</span></nav>';
$banner = '<section class="page-banner page-banner-photo pricing-hero"><div class="container">'
    . '<h1>BẢNG GIÁ DỊCH VỤ</h1>' . $breadcrumb . '</div><picture class="banner-img">'
    . '<source media="(max-width:600px)" srcset="' . $ea($bannerMobile) . '">'
    . '<img src="' . $ea($bannerImage) . '" alt="Bảng giá dịch vụ chăm sóc sức khỏe Văn Lang">'
    . '</picture></section>';

$groupOptions = '<option value="">Tất cả nhóm dịch vụ</option>';
foreach ($groups as $code => $label) {
    $groupOptions .= '<option value="' . $ea($code) . '"' . ($code === $group ? ' selected' : '') . '>'
        . $e($label) . '</option>';
}
$filterBar = '<form class="pricing-search" method="get" action="' . $ea($this->url('pricing')) . '">'
    . '<input class="input pricing-search-input" type="search" name="q" value="' . $ea($q)
    . '" placeholder="Tra cứu giá dịch vụ">'
    . '<select name="nhom" class="select pricing-search-select">' . $groupOptions . '</select>'
    . '<button class="btn btn-teal" type="submit">Tra cứu</button>'
    . ($group !== '' || $q !== '' ? '<a class="btn btn-white" href="'
        . $ea($this->url('pricing')) . '">Xoá lọc</a>' : '') . '</form>';

$bodyRows = '';
$rowNumber = 0;
foreach ($blocks as $block) {
    $bodyRows .= '<tr class="pricing-parent-row"><td class="pricing-parent-cell" colspan="4">'
        . '<strong>' . $e($block['name'] ?? '') . '</strong></td></tr>';
    foreach ((array) ($block['items'] ?? []) as $item) {
        if (! is_array($item)) {
            continue;
        }
        $rowNumber++;
        $price = (string) ($item['priceText'] ?? 'Liên hệ');
        $unit = trim((string) ($item['unit'] ?? ''));
        $note = trim((string) ($item['note'] ?? ''));
        $bodyRows .= '<tr><td class="pricing-index">' . $rowNumber . '</td>'
            . '<td class="pricing-name"><strong>' . $e($item['name'] ?? '') . '</strong>'
            . ($note !== '' ? '<small>' . $e($note) . '</small>' : '') . '</td>'
            . '<td class="pricing-unit">' . $e($unit) . '</td>'
            . '<td class="pricing-price' . ($price === 'Liên hệ' ? ' pricing-contact' : '') . '">'
            . $e($price) . '</td></tr>';
    }
}
$tableHtml = $bodyRows === ''
    ? '<div class="pricing-card"><p class="news-empty">Không có dịch vụ phù hợp.</p></div>'
    : '<div class="pricing-card pricing-card-unified"><div class="table-wrap">'
        . '<table class="data-table pricing-table pricing-table-public"><thead><tr>'
        . '<th>STT</th><th>Tên dịch vụ</th><th>Đơn vị</th><th>Giá tham khảo</th>'
        . '</tr></thead><tbody>' . $bodyRows . '</tbody></table></div></div>';

$sideCard = '<aside class="pricing-side-card"><div class="pricing-hotline-icon">☎</div>'
    . '<span>Hotline</span><strong>' . $e($contact['hotline']) . '</strong>'
    . '<p>Liên hệ ngay với Văn Lang để được tư vấn gói dịch vụ phù hợp và nhận báo giá chi tiết.</p>'
    . '<a class="btn btn-teal" href="' . $ea($contact['hotlineHref']) . '">Gọi tư vấn</a></aside>';
$notice = '<p class="pricing-note-lead">Bảng giá dùng để tham khảo và được sắp xếp theo từng nhóm dịch vụ. '
    . 'Giá thực tế có thể thay đổi theo thời điểm, khu vực và tình trạng chăm sóc.</p>';
$summary = '<p class="news-count">' . ($total > 0 ? 'Có ' . $total . ' dịch vụ phù hợp.' : 'Bảng giá đang cập nhật.') . '</p>';

echo $banner . '<section class="section"><div class="container pricing-layout"><main>'
    . '<h2 class="pricing-title">BẢNG GIÁ DỊCH VỤ</h2>' . $notice . $filterBar . $summary
    . '<div class="pricing-unified">' . $tableHtml . '</div></main>' . $sideCard . '</div></section>';
