<?php

declare(strict_types=1);

/**
 * Trang dịch vụ /dich-vu — cha làm bộ lọc, con làm card (FR-08):
 * Box1 banner + lọc ?nhom=<slug-cha> + danh sách con phân trang 12/trang
 * + Box bảng giá rút gọn + Box CTA.
 * Chuẩn .phtml chuỗi-based (AGENTS §2 / 07 §8): không control structure trong body, dựng bằng chuỗi.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var list<array<string, mixed>> $services
 * @var int $total
 * @var int $page
 * @var int $pages
 * @var list<array{id: int, name: string, slug: string}> $parentFilters
 * @var array{id: int, name: string, slug: string}|null $selectedParent
 * @var array{items: list<array<string,mixed>>, total: int} $pricing
 * @var string|null $mapUrl
 * @var array<string, string|null> $settings
 */

$services = is_array($this->services ?? null) ? $this->services : [];
$total    = (int) ($this->total ?? 0);
$page     = max(1, (int) ($this->page ?? 1));
$pages    = max(0, (int) ($this->pages ?? 0));
$parentFilters = is_array($this->parentFilters ?? null) ? $this->parentFilters : [];
$selectedParent = is_array($this->selectedParent ?? null) ? $this->selectedParent : null;
$pricingData = is_array($this->pricing ?? null) ? $this->pricing : [];
$pricingItems = is_array($pricingData['items'] ?? null) ? $pricingData['items'] : [];
$mapUrl   = is_string($this->mapUrl ?? null) ? $this->mapUrl : null;
$settings = is_array($this->settings ?? null) ? $this->settings : [];

$this->headTitle('Dịch vụ · Văn Lang');

$view = $this;
$e    = static fn (mixed $v): string => $view->escapeHtml((string) $v);
$ea   = static fn (mixed $v): string => $view->escapeHtmlAttr((string) $v);
$img  = static function (mixed $image) use ($view, $e): string {
    if (! is_array($image) || (string) ($image['path'] ?? '') === '') {
        return '';
    }

    return '<img src="' . $e($view->mediaUrl((string) $image['path'])) . '" alt="' . $e($image['alt'] ?? '') . '" loading="lazy">';
};

$hotline  = (string) ($settings['hotline'] ?? '1900 1234');
$zaloUrl  = (string) ($settings['zalo_url'] ?? '');
$address  = (string) ($settings['address'] ?? '');
$hotlineHref = 'tel:' . preg_replace('/\s+/', '', $hotline);
$bannerImage  = $this->basePath('assets/img/banner-dich-vu-v2.jpg');
$bannerMobile = $this->basePath('assets/img/banner-dich-vu-mobile-v2.jpg');
$breadcrumb = '<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span> › </span><span aria-current="page">Dịch vụ</span></nav>';

/* Box1 banner */
$banner = '<section class="page-banner page-banner-photo"><div class="container"><h1>DỊCH VỤ</h1>' . $breadcrumb
    . '</div><picture class="banner-img"><source media="(max-width:600px)" srcset="' . $ea($bannerMobile) . '">'
    . '<img src="' . $ea($bannerImage) . '" alt="Dịch vụ chăm sóc sức khỏe Văn Lang"></picture></section>';

/* ---- Bộ lọc dịch vụ cha + lưới dịch vụ con ---- */
$selectedSlug = (string) ($selectedParent['slug'] ?? '');
$filterOptions = '<option value="">Tất cả nhóm dịch vụ</option>';
$parentNames = [];
foreach ($parentFilters as $parent) {
    $slug = (string) ($parent['slug'] ?? '');
    $parentNames[(int) ($parent['id'] ?? 0)] = (string) ($parent['name'] ?? '');
    $selected = $slug !== '' && $slug === $selectedSlug ? ' selected' : '';
    $filterOptions .= '<option value="' . $ea($slug) . '"' . $selected . '>'
        . $e($parent['name'] ?? '') . '</option>';
}
$countText = $total > 0 ? $e($total) . ' dịch vụ đang hiển thị' : 'Danh sách đang được cập nhật';
$toolbar = '<div class="service-directory-head"><div class="service-directory-heading">'
    . '<span>Dịch vụ chăm sóc</span><h2>Lựa chọn dịch vụ phù hợp</h2>'
    . '<p>Đồng hành cùng bạn và gia đình với các dịch vụ chăm sóc sức khỏe toàn diện, an toàn và tận tâm.</p>'
    . '</div><form class="service-directory-filter" method="get" action="/dich-vu">'
    . '<div class="service-directory-filter-row"><label for="nhom-dich-vu">Nhóm dịch vụ</label>'
    . '<select id="nhom-dich-vu" name="nhom" onchange="this.form.submit()">'
    . $filterOptions . '</select><button class="btn btn-teal" type="submit">⌁ Lọc</button></div>'
    . '<small>' . $countText . '</small></form></div>';
$cards = '';
$cardIndex = 0;
foreach ($services as $card) {
    $cardIndex++;
    $desc = trim((string) ($card['shortDescription'] ?? ''));
    if ($desc === '') {
        $desc = 'Dịch vụ được thiết kế linh hoạt theo nhu cầu chăm sóc thực tế của người bệnh và gia đình.';
    }

    $icon = '<span class="service-directory-icon service-directory-icon--fallback" aria-hidden="true">'
        . '<svg viewBox="0 0 64 64" focusable="false"><path d="M27 12h10v15h15v10H37v15H27V37H12V27h15z"/></svg></span>';
    if (isset($card['icon']) && is_array($card['icon'])) {
        $icon = '<span class="service-directory-icon">' . $img($card['icon']) . '</span>';
    }

    $parentName = $parentNames[(int) ($card['parentId'] ?? 0)]
        ?? (string) ($selectedParent['name'] ?? 'Dịch vụ chuyên môn');
    $tone = (($cardIndex - 1) % 5) + 1;
    $cards .= '<a class="service-directory-card service-directory-card--tone-' . $tone . '" href="'
        . $ea($card['href'] ?? '/dich-vu/' . ($card['slug'] ?? '')) . '">'
        . '<span class="service-directory-accent" aria-hidden="true"></span>'
        . $icon . '<span class="service-directory-card-body"><span class="service-directory-badge">'
        . $e($parentName) . '</span><h3>' . $e($card['name'] ?? '') . '</h3><p>' . $e($desc) . '</p>'
        . '<span class="service-directory-link">Xem chi tiết <i aria-hidden="true">→</i></span></span></a>';
}

$body = $cards === ''
    ? '<p class="news-empty">Hiện tại chưa có dịch vụ nào được công khai.</p>'
    : '<div class="service-directory-grid">' . $cards . '</div>';

$pageUrl = static function (int $p) use ($selectedSlug): string {

    $query = ['page' => $p];
    if ($selectedSlug !== '') {
        $query['nhom'] = $selectedSlug;
    }

    return '/dich-vu?' . http_build_query($query);
};
$pager = '';
if ($pages > 1) {
    $window = \Frontend\Constant\FrontendConst::PAGER_WINDOW;
    $from   = max(1, $page - $window);
    $to     = min($pages, $page + $window);

    $pager = '<nav class="pager" aria-label="Phân trang">';
    if ($page > 1) {
        $pager .= '<a class="pager-link" href="' . $e($pageUrl($page - 1)) . '">&laquo; Trước</a>';
    }

    if ($from > 1) {
        $pager .= '<a class="pager-link" href="' . $e($pageUrl(1)) . '">1</a>'
            . ($from > 2 ? '<span class="pager-gap">…</span>' : '');
    }

    $numbers = '';
    for ($p = $from; $p <= $to; $p++) {
        $numbers .= $p === $page
            ? '<span class="pager-current" aria-current="page">' . $p . '</span>'
            : '<a class="pager-link" href="' . $e($pageUrl($p)) . '">' . $p . '</a>';
    }

    $pager .= $numbers;

    if ($to < $pages) {
        $pager .= ($to < $pages - 1 ? '<span class="pager-gap">…</span>' : '')
            . '<a class="pager-link" href="' . $e($pageUrl($pages)) . '">' . $pages . '</a>';
    }

    if ($page < $pages) {
        $pager .= '<a class="pager-link" href="' . $e($pageUrl($page + 1)) . '">Sau &raquo;</a>';
    }

    $pager .= '</nav>';
}

$servicesBlock = '<section class="section"><div class="container">'
    . '<div class="service-directory">' . $toolbar . $body . $pager . '</div>'
    . '</div></section>';

/* Box bảng giá rút gọn */
$priceRows = '';
foreach ($pricingItems as $row) {
    $name      = (string) ($row['name'] ?? '');
    $unit      = (string) ($row['unit'] ?? '');
    $note      = (string) ($row['note'] ?? '');
    $price     = (string) ($row['priceText'] ?? 'Liên hệ');
    $priceCls  = $price === 'Liên hệ' ? 'pricing-price pricing-contact' : 'pricing-price';

    $priceRows .= '<tr>'
        . '<td class="pricing-name"><strong>' . $e($name) . '</strong></td>'
        . '<td class="pricing-unit">' . $e($unit) . '</td>'
        . '<td class="' . $priceCls . '">' . $e($price) . '</td>'
        . '<td class="pricing-note">' . $e($note) . '</td>'
        . '</tr>';
}
if ($priceRows === '') {
    $priceRows = '<tr><td colspan="4" class="news-empty">Bảng giá đang cập nhật.</td></tr>';
}
$pricingBlock = '<section class="section section-alt"><div class="container">'
    . '<div class="sec-label"><span class="arr">→</span> Bảng giá tham khảo <span class="arr">←</span></div>'
    . '<div class="pricing-card" style="margin-top:14px"><div class="table-wrap"><table class="data-table pricing-table pricing-table-public pricing-table-home"><thead><tr><th>Tên dịch vụ</th><th>Đơn vị</th><th>Giá tham khảo</th><th>Ghi chú</th></tr></thead><tbody>' . $priceRows . '</tbody></table></div></div>'
    . '<div style="text-align:center;margin-top:14px"><a class="btn btn-teal" href="/bang-gia">Xem bảng giá đầy đủ →</a></div>'
    . '</div></section>';

/* Box CTA liên hệ */
$zaloBtn = $zaloUrl !== '' ? '<a class="btn btn-white" href="' . $ea($zaloUrl) . '" target="_blank" rel="noopener">Zalo OA</a>' : '';
$addrLine = $address !== '' ? '<p style="font-size:12.5px;color:var(--muted);margin-top:6px">📍 ' . $e($address) . '</p>' : '';
$mapFrame = $mapUrl !== null && $mapUrl !== ''
    ? '<div class="map-card" style="margin-top:12px;height:200px"><iframe src="' . $ea($mapUrl) . '" width="100%" height="200" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>'
    : '';
$ctaBlock = '<section class="section"><div class="container"><div class="cta-bottom">'
    . '<div class="cta-left"><div><h3>ĐỂ CHÚNG TÔI ĐỒNG HÀNH<br>VÀ CHĂM SÓC NGƯỜI THÂN CỦA BẠN</h3><p>Liên hệ ngay để được tư vấn và nhận báo giá chi tiết cho dịch vụ phù hợp.</p>' . $addrLine . '</div></div>'
    . '<div class="cta-actions"><a class="btn btn-teal cta-phone" href="' . $ea($hotlineHref) . '">☎ ' . $e($hotline) . ' <small>Tư vấn · Đặt lịch</small></a>' . $zaloBtn . '<a class="btn btn-white cta-reg" href="/lien-he">Liên hệ ngay</a></div>'
    . '</div>' . $mapFrame . '</div></section>';

echo $banner . $servicesBlock . $pricingBlock . $ctaBlock;
