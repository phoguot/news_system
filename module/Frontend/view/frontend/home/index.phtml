<?php

/**
 * Trang chủ (FR-32): render list block do Frontend\Service\HomeService dựng
 * (payload cache 'home-v1', TTL 60s — FR-39). Chuẩn .phtml (AGENTS §2 /
 * 07 §8): thân template KHÔNG có control structure PHP — mọi mảnh HTML động
 * dựng bằng chuỗi trong block đầu file. Dữ liệu là mảng thuần; path ảnh
 * tương đối qua helper `mediaUrl`. Section rỗng/thiếu dữ liệu đã được
 * HomeService loại trước — ở đây chỉ việc in.
 *
 * @var list<array<string, mixed>> $sections
 */

/** @var \Laminas\View\Renderer\PhpRenderer $this */

$this->headTitle('Trang chủ');

$view = $this;
$e    = static fn (mixed $v): string => $view->escapeHtml((string) $v);
$img  = static function (mixed $image) use ($view, $e): string {
    if (! is_array($image) || (string) ($image['path'] ?? '') === '') {
        return '';
    }

    return '<img src="' . $e($view->mediaUrl((string) $image['path']))
        . '" alt="' . $e($image['alt'] ?? '') . '" loading="lazy">';
};

$sections = is_array($this->sections ?? null) ? $this->sections : [];
$blocks   = [];
$hasHero  = false;

foreach ($sections as $section) {
    /** @var array<string, mixed> $section */
    $kind  = (string) ($section['kind'] ?? '');
    $title = (string) ($section['title'] ?? '');
    /** @var list<array<string, mixed>> $items */
    $items = is_array($section['items'] ?? null) ? $section['items'] : [];

    $head = $title !== '' ? '<h2 class="sec-label">' . $e($title) . '</h2>' : '';
    if ((string) ($section['headingHref'] ?? '') !== '') {
        $head .= '<a class="sec-more" href="' . $e($section['headingHref']) . '">Xem tất cả →</a>';
    }

    $cards = '';

    if ($kind === 'hero') {
        $hasHero = true;
        $slides  = '';
        $dots    = '';
        foreach ($items as $i => $slide) {
            $cover       = (string) ($slide['image']['path'] ?? '');
            $mobileCover = (string) ($slide['mobileImage']['path'] ?? $cover);
            $inner = '<div class="slide-inner container"><div class="slide-copy">';
            if ((string) ($slide['title'] ?? '') !== '') {
                $inner .= '<span class="slide-badge">' . $e($slide['title']) . '</span>';
            }
            if ((string) ($slide['subtitle'] ?? '') !== '') {
                $inner .= '<p>' . $e($slide['subtitle']) . '</p>';
            }
            if ((string) ($slide['button'] ?? '') !== '') {
                $target = ! empty($slide['newTab']) ? ' target="_blank" rel="noopener"' : '';
                $inner .= '<div class="slide-actions"><a class="btn btn-white" href="'
                    . $e($slide['href'] ?? '') . '"' . $target . '>' . $e($slide['button']) . '</a></div>';
            }
            $inner .= '</div></div>';
            $style  = $cover !== ''
                ? ' style="--slide-image:url(&quot;' . $e($view->mediaUrl($cover))
                    . '&quot;);--slide-mobile-image:url(&quot;' . $e($view->mediaUrl($mobileCover)) . '&quot;)"'
                : '';
            $slides .= '<figure class="slide"' . $style . '><div class="slide-overlay"></div>'
                . $inner . '</figure>';
            $dots  .= '<button type="button" class="dot' . ($i === 0 ? ' active' : '')
                . '" data-index="' . (int) $i . '" aria-label="Slide ' . ((int) $i + 1) . '"></button>';
        }
        $nav = count($items) > 1
            ? '<button type="button" class="slider-arrow prev" aria-label="Trước">‹</button>'
                . '<button type="button" class="slider-arrow next" aria-label="Sau">›</button>'
                . '<div class="slider-dots">' . $dots . '</div>'
            : '';
        $blocks[] = '<section class="main-slider" data-autoplay="'
            . (! empty($section['autoplay']) ? '1' : '0')
            . '" data-interval="' . (int) ($section['intervalMs'] ?? 5000) . '">'
            . '<div class="slider-viewport"><div class="slider-track">' . $slides . '</div></div>'
            . $nav . '</section>';

        // CHÈN KHỐI TĨNH NGAY SAU HERO
        // $blocks[] = $staticServicesHtml;
        // $staticServicesAdded = true;
        continue;
    }

    if ($kind === 'cta') {
        $blocks[] = '<section class="section"><div class="container"><div class="cta-bottom">'
            . '<div class="cta-left"><div><h2>' . $e($title) . '</h2></div></div>'
            . '<div class="cta-actions"><a class="btn btn-teal" href="'
            . $e($section['href'] ?? '') . '">' . $e($section['button'] ?? '') . '</a></div>'
            . '</div></div></section>';
        continue;
    }

    if ($kind === 'posts') {
        foreach ($items as $card) {
            $minutes = (int) ($card['minutes'] ?? 0);
            $meta    = ((string) ($card['date'] ?? '') . ($minutes > 0
                ? ' · ' . $minutes . ' phút đọc'
                : ''));
            $excerpt = (string) ($card['subtitle'] ?? '');
            $cards  .= '<article class="post-card">'
                . '<a class="post-thumb" href="' . $e($card['href']) . '">'
                . $img($card['image'] ?? null) . '</a><div class="post-body">'
                . ($meta !== '' ? '<span class="mini-badge">' . $e($meta) . '</span>' : '')
                . '<h3><a href="' . $e($card['href']) . '">' . $e($card['title']) . '</a></h3>'
                . ($excerpt !== '' ? '<p>' . $e($excerpt) . '</p>' : '')
                . '</div></article>';
        }
        $blocks[] = '<section class="section"><div class="container">'
            . '<div class="sec-head">' . $head . '</div>'
            . '<div class="post-grid">' . $cards . '</div></div></section>';
        continue;
    }

    if ($kind === 'services') {
        foreach ($items as $card) {
            $serviceTitle = (string) ($card['title'] ?? '');
            $excerpt      = (string) ($card['subtitle'] ?? '');
            $href         = (string) ($card['href'] ?? '');
            $image        = $img($card['image'] ?? null);
            $icon         = $img($card['icon'] ?? null);
            $titleIcon    = $icon !== ''
                ? '<span class="svc-icon">' . $icon . '</span>'
                : '<svg viewBox="0 0 24 24" width="44.8" height="44.8" stroke="currentColor" fill="none"'
                    . ' stroke-width="2" class="title-icon"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z">'
                    . '</path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>';

            $cards .= '<div class="main-svc-box"><div class="sec-head"><h2 class="sec-label">'
                . $titleIcon . $e($serviceTitle) . '</h2>'
                . ($excerpt !== '' ? '<p class="sec-subtitle">' . $e($excerpt) . '</p>' : '')
                . '</div><div class="ms-content-wrap">'
                . ($image !== '' ? '<div class="ms-image">' . $image . '</div>' : '')
                . '<div class="ms-details"><h3>' . $e($serviceTitle) . '</h3>'
                . ($excerpt !== '' ? '<p>' . $e($excerpt) . '</p>' : '')
                . '<a href="' . $e($href) . '" class="btn btn-teal">Tìm hiểu thêm →</a>'
                . '</div><div class="ms-highlight"><div class="hl-icon">'
                . '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48">'
                . '<path fill="#115E59" d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7V2z"></path>'
                . '</svg></div><p>Dịch vụ tận tâm<br><strong>An tâm mỗi ngày</strong></p>'
                . '</div></div></div>';
        }
        $blocks[] = '<section class="section section-alt"><div class="container">'
            . $cards . '</div></section>';
        continue;
    }
    if ($kind === 'process') {
        $subtitle = (string) ($section['subtitle'] ?? '');
        foreach ($items as $card) {
            $idx  = (int) ($card['index'] ?? 0);
            $desc = (string) ($card['subtitle'] ?? '');
            $cards .= '<div class="process-step"><span class="process-num">' . $e($idx) . '</span>'
                . '<h4>' . $e($card['title']) . '</h4>'
                . ($desc !== '' ? '<p>' . $e($desc) . '</p>' : '')
                . '</div>';
        }
        $blocks[] = '<section class="section section-alt"><div class="container">'
            . '<div class="sec-head">' . $head
            . ($subtitle !== '' ? '<p class="sec-subtitle">' . $e($subtitle) . '</p>' : '')
            . '</div><div class="process-grid">' . $cards . '</div></div></section>';
        continue;
    }

    if ($kind === 'team') {
        foreach ($items as $card) {
            $role    = (string) ($card['subtitle'] ?? '');
            $cards  .= '<div class="team-card"><div class="team-avatar">'
                . $img($card['image'] ?? null) . '</div><div><h4>' . $e($card['title']) . '</h4>'
                . ($role !== '' ? '<span class="role">' . $e($role) . '</span>' : '')
                . '</div></div>';
        }
        $blocks[] = '<section class="section"><div class="container">'
            . '<div class="sec-head">' . $head . '</div>'
            . '<div class="team-grid">' . $cards . '</div></div></section>';
        continue;
    }

    if ($kind === 'pricing') {
        $cardsHtml = '';
        foreach ($items as $i => $item) {
            $num = (int) ($i + 1);
            $price = $item['price'] === null
                ? 'Liên hệ'
                : number_format((int) $item['price'], 0, ',', '.') . ' ₫';
            $cardsHtml .= '<a class="pricing-grid-card" href="' . $e($item['href'] ?? '#') . '">'
                . '<div class="pricing-grid-hd">'
                . '<span class="pricing-num">' . $e($num) . '</span>'
                . '<span class="pricing-name">' . $e($item['title'] ?? $item['name'] ?? '') . '</span>'
                . '</div>'
                . '<div class="pricing-grid-bd">'
                . '<span class="pricing-amount">' . $e($price) . '</span>'
                . '</div></a>';
        }
        $blocks[] = '<section class="section section-alt"><div class="container">'
            . '<div class="sec-head">' . $head . '</div>'
            . '<div class="pricing-grid">' . $cardsHtml . '</div>'
            . '<div style="text-align:center;margin-top:24px">'
            . '<a class="btn btn-teal" href="' . $e($view->url('pricing'))
            . '">Xem bảng giá đầy đủ →</a></div></div></section>';
        continue;
    }

    if ($kind === 'reviews') {
        $rating = (float) ($section['averageRating'] ?? 0);
        $ratingPercent = max(0, min(100, ($rating / 5) * 100));
        $total = (int) ($section['totalReviews'] ?? 0);
        $counts = is_array($section['starCounts'] ?? null) ? $section['starCounts'] : [];
        $denominator = max(1, $total, array_sum(array_map('intval', $counts)));
        $bars = '';
        foreach ([5, 4, 3, 2, 1] as $star) {
            $count = max(0, (int) ($counts[$star] ?? 0));
            $percent = min(100, ($count / $denominator) * 100);
            $bars .= '<div class="review-bar-row"><span class="review-star-label">★ ' . $star . '</span>'
                . '<span class="review-bar"><i style="width:' . $e(number_format($percent, 2, '.', '')) . '%"></i></span>'
                . '<strong>' . $e(number_format($count, 0, ',', '.')) . '</strong></div>';
        }
        $gallery = '';
        foreach ($items as $item) {
            $image = $img($item['image'] ?? null);
            if ($image !== '') {
                $gallery .= '<figure class="review-shot">' . $image . '</figure>';
            }
        }
        $galleryHtml = $gallery !== '' ? '<div class="review-gallery">' . $gallery . '</div>' : '';
        $subtitle = (string) ($section['subtitle'] ?? '');
        $blocks[] = '<section class="section review-section"><div class="container">'
            . '<div class="sec-head"><h2 class="sec-label">' . $e($title) . '</h2>'
            . ($subtitle !== '' ? '<p class="sec-subtitle">' . $e($subtitle) . '</p>' : '') . '</div>'
            . '<div class="review-summary"><div class="review-score"><strong>' . $e(number_format($rating, 1)) . '</strong><span>/5</span>'
            . '<div class="review-stars" aria-label="' . $e($rating) . ' trên 5 sao"><span>★★★★★</span>'
            . '<i style="width:' . $e(number_format($ratingPercent, 2, '.', '')) . '%">★★★★★</i></div>'
            . '<p>' . $e(number_format($total, 0, ',', '.')) . ' đánh giá</p></div>'
            . '<div class="review-bars">' . $bars . '</div></div>'
            . $galleryHtml . '</div></section>';
        continue;
    }
}
$bodyHtml = $blocks === []
    ? '<section class="section"><div class="container"><p>Trang chủ chưa có khối nào bật.'
        . ' Vào <a href="/admin/home-sections">Admin → Bố cục trang chủ</a> để thêm và bật section.'
        . '</p></div></section>'
    : implode('', $blocks);

$scriptHtml = $hasHero
    ? '<script src="' . $e($this->basePath('assets/js/home-slider.js')) . '"></script>'
    : '';

echo $bodyHtml . $scriptHtml;
